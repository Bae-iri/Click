  "code_mechanisms": [
    {
      "id": "no_same_state_retry",
      "evidence_level": "confirmed_code",
      "source": "Frontend/app/src/main/java/com/click/service/overlay/AppTaskMetaController.java:after/blocked/key",
      "fact": "After a fresh public action remains WAITING beyond its wait/event allowance, META remembers the action key as rejected and returns REOBSERVE. Same-fingerprint/tool/target/package proposals are blocked; recovery count is bounded. It does not execute a retry or invoke a reflection model.",
      "implication": "A replan can select a different action or hand off; the original accepted-but-unconfirmed navigation is not itself repaired.",
      "boundary": "Avoiding duplicate or harmful actions is intentional; this finding does not authorize unrestricted retries."
    },
    {
      "id": "recovery_context_not_transmitted",
      "evidence_level": "confirmed_code",
      "sources": [
        "Frontend/app/src/main/java/com/click/service/overlay/AppTaskController.java:request",
        "Backend/app/services/app_task.py:context/recent_attempts"
      ],
      "fact": "The planner receives generic tool/target/outcome/same_screen attempt history, but not the META recovery trigger, pending native dispatch status, rejected-key set, remaining recovery budget, or frozen per-node action eligibility.",
      "implication": "Additional queries are not a separately trained or failure-specific repair model. Generic failure history is present; history is not wholly absent."
    },
    {
      "id": "pending_dispatch_not_in_policy",
      "evidence_level": "confirmed_code",
      "sources": [
        "Frontend/app/src/main/java/com/click/service/overlay/AppTaskMetaController.java:NORMAL_WAIT_MS/after",
        "Frontend/app/src/androidTest/java/com/click/service/accessibility/MetaControllerSettingsExperimentTest.java:Driver.execute/approve"
      ],
      "fact": "Policy may REOBSERVE after 5000 ms, while the injected native dispatch is delayed 5500 ms. Harness pending state blocks another approval and primary success but is not an input to META.after or planner scheduling.",
      "implication": "A new model request may begin before the original delayed operation settles. A response to an old fingerprint can then be discarded and another request made.",
      "historical_timing_limit": "Historical request receipts and native action elapsed times lack one shared recorded episode-start anchor and per-recovery timestamps; exact pending/replan ordering is not established for every old episode."
    },
    {
      "id": "planner_executor_capability_gap",
      "evidence_level": "confirmed_code",
      "sources": [
        "Backend/app/services/app_task.py:controls/context/schema",
        "Backend/scripts/serve_meta_controller_settings_experiment.py:allowed/navigation_action_allowed/_invoke",
        "experiments/metacontroller/native-settings-catalogue-v1.json:navigation_controls"
      ],
      "fact": "Readable public controls and generic Android tools enter planning, while the frozen navigation whitelist is enforced after the model response. Public alternative controls may be visible but ineligible for execution.",
      "implication": "A paid model attempt can produce a normally grounded proposal and still receive experimental HTTP 422. The capability restriction is not supplied as a per-control planning constraint.",
      "historical_limit": "The 6 historical blocked proposal bodies/types were not retained. This mechanism does not identify which action each block proposed and does not establish an attempted setting mutation."
    },
    {
      "id": "gateway_failure_not_a_recovery_input",
      "evidence_level": "confirmed_code_and_observed_harness_state",
      "sources": [
        "Frontend/app/src/main/java/com/click/service/overlay/AppTaskController.java:gateway.Callback.failure",
        "Frontend/app/src/androidTest/java/com/click/service/accessibility/MetaControllerSettingsExperimentTest.java:Driver.failure"
      ],
      "fact": "Gateway failure clears busy and delegates to the Listener without a new presented status or META recovery decision. All 6 historical HTTP 422 episodes end with last presented status planning near the 30 s cutoff; the frozen harness Listener records a failure count only.",
      "boundary": "This establishes the diagnostic harness presentation/feedback gap. A production Listener can render an error separately; the retained dataset does not establish identical production UI behavior."
    },
    {
      "id": "shared_completion_projection_defect",
      "evidence_level": "confirmed_code_and_separate_regression",
      "source": "../2026-11-20-completion-title-fix/verification.json",
      "fact": "A passive scroll ancestor sharing a native heading label could erase that heading under result-label projection. A separate patch and focused native/model bridge diagnosed this shared completion path.",
      "boundary": "Historical exact candidates were not retained. This does not prove every old missing verification had that cause; the controlled bridge is not a rerun of 36 or evidence that B is now better."
    }
  ],
