{
  "paths": {
    "/api/v1/agent/commands": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCommandRequest"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentCommandRequest": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "agent-fe-contract.v0.2",
            "title": "Contract Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Request Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Session Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "episode_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Id"
          },
          "command_type": {
            "type": "string",
            "enum": [
              "start_task",
              "pause_task",
              "resume_task",
              "cancel_task",
              "replace_task",
              "observe",
              "respond_confirmation"
            ],
            "title": "Command Type"
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TypedGoalRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "device_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceContextRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessibility_tree": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccessibilityTree"
              },
              {
                "type": "null"
              }
            ]
          },
          "vision_snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisionSnapshot"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_action_event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserActionEventRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_confirmation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "accepted",
                  "rejected"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "User Confirmation"
          },
          "confirmation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36,
                "minLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmation Id"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          },
          "classification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassificationMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contract_version",
          "request_id",
          "session_id",
          "expected_version",
          "command_type"
        ],
        "title": "AgentCommandRequest"
      },
      "TypedGoalRequest": {
        "properties": {
          "catalog_version": {
            "type": "string",
            "enum": [
              "1.0.0",
              "1.1.0",
              "2.0.0",
              "2.1.0"
            ],
            "title": "Catalog Version"
          },
          "goal_type": {
            "type": "string",
            "enum": [
              "settings.font_size.increase",
              "settings.font_size.decrease",
              "settings.wifi.enable",
              "settings.wifi.disable",
              "settings.wifi.connect",
              "settings.bluetooth.enable",
              "settings.bluetooth.disable",
              "settings.bluetooth.connect",
              "settings.mobile_data.enable",
              "settings.mobile_data.disable",
              "settings.airplane_mode.enable",
              "settings.airplane_mode.disable",
              "settings.hotspot.enable",
              "settings.hotspot.disable",
              "settings.brightness.increase",
              "settings.brightness.decrease",
              "settings.dark_mode.enable",
              "settings.dark_mode.disable",
              "settings.screen_timeout.set",
              "settings.display_size.increase",
              "settings.display_size.decrease",
              "settings.volume.increase",
              "settings.volume.decrease",
              "settings.mute.enable",
              "settings.mute.disable",
              "settings.ringtone.change",
              "settings.vibrate.enable",
              "settings.vibrate.disable",
              "settings.notifications.enable",
              "settings.notifications.disable",
              "settings.location.enable",
              "settings.location.disable",
              "settings.power_saving.enable",
              "settings.power_saving.disable",
              "settings.screen_lock.change",
              "settings.biometric.setup",
              "settings.apps.uninstall",
              "settings.app_permissions.manage",
              "settings.storage.cleanup",
              "settings.talkback.enable",
              "settings.talkback.disable",
              "settings.magnification.enable",
              "settings.magnification.disable",
              "settings.language.change",
              "settings.date_time.automatic.enable",
              "settings.date_time.automatic.disable",
              "settings.keyboard.change",
              "settings.default_apps.change",
              "settings.wifi.share",
              "settings.wifi.saved_networks.view",
              "settings.nfc.enable",
              "settings.nfc.disable",
              "settings.do_not_disturb.enable",
              "settings.do_not_disturb.disable",
              "settings.auto_rotate.enable",
              "settings.auto_rotate.disable",
              "settings.eye_comfort.enable",
              "settings.eye_comfort.disable",
              "settings.adaptive_brightness.enable",
              "settings.adaptive_brightness.disable",
              "settings.data_saver.enable",
              "settings.data_saver.disable",
              "settings.data_roaming.enable",
              "settings.data_roaming.disable",
              "settings.vpn.connect",
              "settings.vpn.disconnect",
              "settings.private_dns.change",
              "settings.sim.manage",
              "settings.hotspot.password.change",
              "settings.wallpaper.change",
              "settings.notification_sound.change",
              "settings.battery_percentage.enable",
              "settings.battery_percentage.disable",
              "settings.battery_status.view",
              "settings.app_cache.clear",
              "settings.app_data.clear",
              "settings.notification_history.view",
              "settings.lockscreen_notifications.manage",
              "settings.color_inversion.enable",
              "settings.color_inversion.disable",
              "settings.captions.enable",
              "settings.captions.disable",
              "settings.mono_audio.enable",
              "settings.mono_audio.disable",
              "settings.backup.enable",
              "settings.backup.disable",
              "settings.software_update.check",
              "settings.factory_reset",
              "settings.device_name.change"
            ],
            "title": "Goal Type"
          },
          "target_app": {
            "type": "string",
            "const": "android_settings",
            "title": "Target App"
          },
          "slots": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Slots"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_version",
          "goal_type",
          "target_app",
          "slots"
        ],
        "title": "TypedGoalRequest"
      }
    }
  }
}
