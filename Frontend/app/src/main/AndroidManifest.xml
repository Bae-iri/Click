<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <queries>
        <package android:name="com.kakao.talk" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ClickApplication"
        android:icon="@drawable/ic_click_cursor"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Click">
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SignUpActivity" android:exported="false" />
        <activity android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${kakaoRedirectScheme}" android:host="oauth" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MenuActivity" android:exported="false" />
        <activity android:name=".DisplaySettingsActivity" android:exported="false" />
        <activity android:name=".AboutClueActivity" android:exported="false" />
        <activity android:name=".TutorialReadyActivity" android:exported="false" />
        <activity android:name=".TutorialActivity" android:exported="false" />
        <activity android:name=".OverlayTutorialActivity" android:exported="false" />
        <activity android:name=".AccessibilityPermissionTutorialActivity" android:exported="false" />

        <service
            android:name=".service.overlay.ClickOverlayService"
            android:exported="false" />

        <service
            android:name=".service.accessibility.ClickAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/click_accessibility_service" />
        </service>
    </application>
</manifest>
