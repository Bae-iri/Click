<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="onboarding_surface">#FFFFFF</color>
    <color name="onboarding_blue">#3F78F7</color>
    <color name="onboarding_blue_light">#EEF4FF</color>
    <color name="onboarding_text_primary">#111B32</color>
    <color name="onboarding_text_secondary">#7383A2</color>
    <color name="onboarding_skip">#7A8AA8</color>
    <color name="onboarding_bubble_text">#17213A</color>
    <color name="onboarding_inactive">#DCE4F1</color>

    <string name="onboarding_title">핸드폰 사용을 위해\n누군가에게 도움을\n구한 적이 있나요?</string>
    <string name="onboarding_description">설정을 바꾸거나 낯선 앱을 사용할 때\n어떻게 해야 할지 모르겠다면\n클릭을 사용해봐요!</string>
    <string name="onboarding_bubble">클릭은 그런 작업을\n쉽게 따라 할 수 있도록 안내해요!</string>
    <string name="onboarding_skip">건너뛰기</string>
    <string name="onboarding_signup">가입하기</string>
    <string name="onboarding_login">전화번호로 로그인하기</string>
    <string name="onboarding_start">시작하기</string>
    <string name="onboarding_question_title">궁금한 화면을\n물어보세요</string>
    <string name="onboarding_question_description">지금 보고 있는 화면을\n클릭이 이해하고 알려드려요.</string>
    <string name="onboarding_question_bubble">이 버튼이\n뭔가요?</string>
    <string name="onboarding_task_title">글자 크기\n어떻게 키우더라?</string>
    <string name="onboarding_task_quote">“휴대폰 글자를 크게 보고 싶어요”</string>
    <string name="onboarding_task_bubble">글자 크기 키워줘</string>
    <string name="onboarding_guide_bubble">클릭이 이렇게\n안내해드려요!</string>
    <string name="onboarding_task_description">묻지 말고 클릭과 함께해요.</string>
    <string name="onboarding_phone_description">안내 예시: 디스플레이 화면의 글자 크기와 스타일 항목을 파란색으로 알려드려요.</string>
    <string name="onboarding_phone_display">디스플레이</string>
    <string name="onboarding_phone_brightness">밝기</string>
    <string name="onboarding_phone_adaptive">밝기 최적화</string>
    <string name="onboarding_phone_mode">화면 모드</string>
    <string name="onboarding_phone_mode_value">선명한 화면</string>
    <string name="onboarding_phone_font">글자 크기와 스타일</string>
    <string name="onboarding_phone_font_hint">글자 크기 조절</string>
    <string name="onboarding_phone_zoom">화면 크게 / 작게</string>
    <string name="onboarding_ready_title">이제, 더 편하게\n사용해보세요!</string>
    <string name="onboarding_ready_description">언제 어디서든\n클릭이 함께 할게요.</string>
    <string name="onboarding_feature_explain">화면 설명</string>
    <string name="onboarding_feature_find">원하는 기능 찾아주기</string>
    <string name="onboarding_feature_prevent">실수 방지 알림</string>
    <string name="onboarding_next">다음</string>
    <string name="onboarding_previous">이전</string>
    <string name="onboarding_welcome_progress">클릭 소개</string>
    <string name="onboarding_step_progress">온보딩, 2단계 중 %1$d단계</string>

    <style name="OnboardingQuietButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/onboarding_skip_background</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/onboarding_skip</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="OnboardingFeatureLabel">
        <item name="android:breakStrategy">balanced</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/onboarding_text_secondary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="Theme.Click.Onboarding" parent="Base.Theme.Click.DesignPreview">
        <item name="android:windowBackground">@color/onboarding_surface</item>
        <item name="android:statusBarColor">@color/onboarding_surface</item>
        <item name="android:navigationBarColor">@color/onboarding_surface</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
    </style>
</resources>
