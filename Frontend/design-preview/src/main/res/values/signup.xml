    <string name="signup_profile_title">안내를 조금 더\n원활히 도와드릴게요</string>
    <string name="signup_profile_description">이름을 입력해 주세요.\n나이와 직업은 선택 사항이에요.</string>
    <string name="signup_name_label">이름</string>
    <string name="signup_name_hint">예) 김클릭</string>
    <string name="signup_email_label">이메일</string>
    <string name="signup_email_hint">예) click@gmail.com</string>
