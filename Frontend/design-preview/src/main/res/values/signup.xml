<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="signup_border">#D9E2F2</color>
    <color name="signup_hint">#7A8AA8</color>
    <color name="signup_error">#C33B43</color>
    <color name="signup_info">#F3F7FF</color>

    <string name="signup_account_title">가입을 시작해볼까요?</string>
    <string name="signup_account_description">로그인할 때 사용할\n전화번호와 비밀번호를 입력해 주세요.</string>
    <string name="signup_profile_title">어떻게 불러드릴까요?</string>
    <string name="signup_profile_description">이름은 화면에 표시할 때만 사용해요.\n입력하지 않고 가입해도 괜찮아요.</string>
    <string name="signup_name_label">이름 (선택)</string>
    <string name="signup_name_hint">예) 김클릭</string>
    <string name="signup_email_label">전화번호</string>
    <string name="signup_email_hint">예) 01012345678</string>
    <string name="signup_email_id_hint">아이디</string>
    <string name="signup_email_domain_select">도메인 선택</string>
    <string name="signup_email_domain_accessibility">전화번호 도메인: %1$s, 눌러서 선택</string>
    <string name="signup_email_domain_custom_label">전화번호 도메인 직접 입력</string>
    <string name="signup_email_domain_custom_hint">예) company.com</string>
    <string name="signup_email_confirmation_title">전화번호를\n확인해 주세요</string>
    <string name="signup_email_confirmation_description">다시 로그인할 때 사용할 전화번호예요.\n자주 사용하는 전화번호인지 확인해 주세요.</string>
    <string name="signup_email_confirmation_label">로그인할 전화번호</string>
    <string name="signup_email_confirmation_continue">이 전화번호로 계속</string>
    <string name="signup_email_confirmation_edit">전화번호 수정</string>
    <string name="signup_email_confirmation_close">전화번호 확인창 닫기</string>
    <string-array name="signup_email_domains">
        <item>naver.com</item>
        <item>gmail.com</item>
        <item>daum.net</item>
        <item>hanmail.net</item>
        <item>kakao.com</item>
        <item>nate.com</item>
        <item>outlook.com</item>
        <item>hotmail.com</item>
        <item>icloud.com</item>
        <item>직접 입력</item>
    </string-array>
    <string name="signup_password_label">비밀번호</string>
    <string name="signup_password_hint">비밀번호 입력</string>
    <string name="signup_password_helper">로그인할 때 사용할 비밀번호를 입력해 주세요.</string>
    <string name="signup_password_hint_length">비밀번호는 숫자 4자리로 입력해 주세요.</string>
    <string name="signup_password_helper_length">비밀번호는 숫자 4자리로 입력해 주세요.</string>
    <string name="signup_password_rules_loading">가입 기준을 확인하고 있어요…</string>
    <string name="signup_password_rules_failed">가입 기준을 확인하지 못했어요. 연결 상태를 확인하고 다시 시도해 주세요.</string>
    <string name="signup_retry">다시 시도</string>
    <string name="signup_error_password_minimum">비밀번호는 숫자 4자리로 입력해 주세요.</string>
    <string name="signup_error_password_maximum">비밀번호는 숫자 4자리로 입력해 주세요.</string>
    <string name="signup_password_confirm_label">비밀번호 확인</string>
    <string name="signup_password_confirm_hint">한 번 더 입력해 주세요.</string>
    <string name="signup_profile_helper">이름을 입력하지 않아도 모든 안내를 이용할 수 있어요.</string>
    <string name="signup_next">다음</string>
    <string name="signup_review">회원가입하기</string>
    <string name="signup_progress">회원가입, 2단계 중 %1$d단계</string>
    <string name="signup_show_password">비밀번호 보기</string>
    <string name="signup_hide_password">비밀번호 숨기기</string>
    <string name="signup_error_email">전화번호 주소를 한 번 더 확인해 주세요.</string>
    <string name="signup_error_name">이름을 입력해 주세요.</string>
    <string name="signup_error_password_confirm">비밀번호가 서로 달라요. 다시 확인해 주세요.</string>
    <string name="signup_information_checked">입력하신 내용을 확인했어요.</string>
    <string name="account_exists_title">이미 가입된\n계정이에요</string>
    <string name="account_exists_description">다시 만나 반가워요!\n로그인하고 클릭을 시작해요.</string>
    <string name="account_exists_email_label">가입된 전화번호</string>
    <string name="account_exists_edit">다른 전화번호로 가입하기</string>
    <string name="account_exists_close">안내창 닫기</string>
    <string name="login_title">다시 만나 반가워요</string>
    <string name="login_description">가입할 때 사용한\n전화번호와 비밀번호를 입력해 주세요.</string>
    <string name="login_password_helper">가입할 때 설정한 비밀번호를 입력해 주세요.</string>
    <string name="login_error_password_required">비밀번호는 숫자 4자리로 입력해 주세요.</string>
    <string name="login_action">로그인하기</string>
    <string name="login_signup">다른 방법으로 시작하기</string>


    <style name="SignupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/onboarding_text_primary</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="SignupDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/onboarding_text_secondary</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="SignupFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/onboarding_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SignupInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/signup_input_background</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColorHint">@color/signup_hint</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textColor">@color/onboarding_text_primary</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="SignupInputInsideButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColorHint">@color/signup_hint</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">64dp</item>
        <item name="android:textColor">@color/onboarding_text_primary</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="SignupHelper">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/onboarding_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SignupError" parent="@style/SignupHelper">
        <item name="android:textColor">@color/signup_error</item>
    </style>

    <style name="SignupInfo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/signup_info_card</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">18dp</item>
        <item name="android:textColor">@color/onboarding_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Click.SignUp" parent="Base.Theme.Click.DesignPreview">
        <item name="android:windowBackground">@color/onboarding_surface</item>
        <item name="android:statusBarColor">@color/onboarding_surface</item>
        <item name="android:navigationBarColor">@color/onboarding_surface</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
    </style>
</resources>
