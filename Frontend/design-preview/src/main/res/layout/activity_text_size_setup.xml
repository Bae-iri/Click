<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_size_setup_screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="24dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <com.click.designpreview.ClickBrandView android:layout_width="106dp"
                    android:layout_height="36dp" android:importantForAccessibility="no" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageButton android:id="@+id/text_size_setup_back"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/account_dialog_close" android:contentDescription="이전 화면으로 돌아가기" />
            </LinearLayout>
            <TextView android:id="@+id/text_size_setup_title" style="@style/SignupTitle"
                android:layout_marginTop="36dp" android:textSize="28sp"
                android:text="@string/text_size_setup_title" android:accessibilityHeading="true" />
            <TextView style="@style/SignupDescription" android:layout_marginTop="16dp"
                android:textSize="16sp" android:lineSpacingExtra="4dp"
                android:text="@string/text_size_setup_description" />
            <com.click.designpreview.TextSizeControlView android:id="@+id/text_size_setup_control"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />
            <com.click.designpreview.UiSpeedControlView android:id="@+id/text_size_setup_speed_control"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>
    <com.click.designpreview.OnboardingStartButton android:id="@+id/text_size_setup_continue"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" android:layout_marginTop="12dp"
        android:minHeight="60dp" android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:gravity="center" android:clickable="true" android:focusable="true"
        android:contentDescription="@string/text_size_setup_continue">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/text_size_setup_continue" android:textSize="20sp"
            android:textColor="@android:color/white" android:fontFamily="@font/pretendard_semibold"
            android:gravity="center" android:includeFontPadding="false" android:importantForAccessibility="no" />
    </com.click.designpreview.OnboardingStartButton>
</LinearLayout>
