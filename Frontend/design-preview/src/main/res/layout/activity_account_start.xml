<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/onboarding_surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <Button android:id="@+id/account_start_back" style="@style/OnboardingQuietButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/account_start_back" />
        <TextView android:id="@+id/account_start_title" style="@style/SignupTitle"
            android:layout_marginTop="36dp" android:text="@string/account_start_title" />
        <TextView style="@style/SignupDescription" android:layout_marginTop="18dp"
            android:text="@string/account_start_description" />
        <TextView style="@style/SignupInfo" android:layout_marginTop="28dp"
            android:text="@string/account_start_kakao_hint" />
        <LinearLayout android:id="@+id/account_start_kakao"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:background="@drawable/kakao_login_background"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/account_start_kakao"
            android:minHeight="66dp" android:gravity="center" android:orientation="horizontal"
            android:paddingHorizontal="16dp" android:paddingVertical="18dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginEnd="12dp" android:importantForAccessibility="no"
                android:src="@drawable/kakao_symbol" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:importantForAccessibility="no" android:text="@string/account_start_kakao"
                android:textColor="#D9000000" android:textSize="21sp" />
        </LinearLayout>
        <TextView android:id="@+id/account_start_progress" style="@style/SignupHelper"
            android:accessibilityLiveRegion="polite" android:gravity="center"
            android:text="@string/account_start_progress" android:visibility="gone" />
        <TextView android:id="@+id/account_start_error" style="@style/SignupError"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <Button android:id="@+id/account_start_email" style="@style/OnboardingQuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="56dp"
            android:text="@string/account_start_email" />
        <Button android:id="@+id/account_start_login" style="@style/OnboardingQuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="@string/account_start_login" />
        <TextView style="@style/SignupHelper" android:layout_marginTop="24dp"
            android:text="@string/account_start_existing" />
    </LinearLayout>
</ScrollView>
