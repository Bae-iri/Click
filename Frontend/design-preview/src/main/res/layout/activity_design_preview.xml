<?xml version="1.0" encoding="utf-8"?>
<com.click.designpreview.SplashLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.click.designpreview.ClickBrandView
        android:id="@+id/splash_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/splash_logo_description" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:text="@string/splash_tagline"
        android:textColor="#627196"
        android:textSize="19sp" />
</com.click.designpreview.SplashLayout>
