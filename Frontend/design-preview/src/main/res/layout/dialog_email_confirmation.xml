<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/email_confirmation_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/account_dialog_card"
    android:overScrollMode="never"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/signup_info_card"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_click_cursor" />
            <ImageButton
                android:id="@+id/email_confirmation_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/signup_email_confirmation_close"
                android:padding="13dp"
                android:src="@drawable/account_dialog_close" />
        </FrameLayout>

        <TextView
            android:id="@+id/email_confirmation_title"
            style="@style/SignupTitle"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/signup_email_confirmation_title"
            android:textSize="26sp" />

        <TextView
            style="@style/SignupDescription"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/signup_email_confirmation_description"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/signup_info_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:includeFontPadding="false"
                android:text="@string/signup_email_confirmation_label"
                android:textColor="@color/onboarding_text_secondary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/email_confirmation_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:breakStrategy="simple"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/onboarding_text_primary"
                android:textDirection="ltr"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/email_confirmation_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@null"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:minHeight="60dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:stateListAnimator="@null"
            android:text="@string/signup_email_confirmation_continue"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/email_confirmation_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/account_dialog_secondary"
            android:backgroundTint="@null"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:minHeight="56dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="14dp"
            android:stateListAnimator="@null"
            android:text="@string/signup_email_confirmation_edit"
            android:textAllCaps="false"
            android:textColor="@color/onboarding_blue"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
