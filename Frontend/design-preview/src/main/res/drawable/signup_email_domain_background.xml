<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#183478F6">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="#EAF2FF" />
                    <stroke android:width="1dp" android:color="#3478F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#F3F7FF" />
                    <stroke android:width="1dp" android:color="#D9E2F2" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
