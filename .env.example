POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://click:replace-me@localhost:5432/click
# Required for persistent storage. Generate TWO independent Fernet keys; keep
# them in the deployment secret store, never Git. First encryption key is active.
DATA_ENCRYPTION_KEYS=
DATA_LOOKUP_KEY=
# Initial conversion of an existing DB requires legacy writers to be stopped.
# Set DATA_ENCRYPTION_MAINTENANCE=1 only for that maintenance migration.
# Optional. If absent or unavailable, matching uses the local keyword scorer.
GEMINI_API_KEY=
# Numeric Kakao Developers app ID. The Android native app key is configured separately.
KAKAO_APP_ID=
# Optional. Our separately deployed Whisper large-v3 worker; blank STT returns 503.
# Remote worker URLs require HTTPS. No external transcription API fallback.
SELF_HOSTED_STT_URL=
SELF_HOSTED_STT_TOKEN=

# Jev is AI1's primary screen/step/target selector. Key stays on Backend.
AI1_UI_SELECTOR_PROVIDER=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_MIN_CONFIDENCE=0.8
# Independent request-goal interpretation provider.
GOAL_CLASSIFIER_PROVIDER=self_hosted

# Optional presentation-only guide wording. Reuses our private LLM endpoint; never Jev.
GUIDE_NARRATION_ENABLED=false
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_TOKEN=
SELF_HOSTED_LLM_MODEL=
