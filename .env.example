POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://click:replace-me@localhost:5432/click
# Optional. If absent or unavailable, matching uses the local keyword scorer.
GEMINI_API_KEY=
# Optional. Our separately deployed Whisper large-v3 worker; blank STT returns 503.
# Remote worker URLs require HTTPS. No external transcription API fallback.
SELF_HOSTED_STT_URL=
SELF_HOSTED_STT_TOKEN=

# Optional presentation-only guide wording. Reuses our private LLM endpoint; never Jev.
GUIDE_NARRATION_ENABLED=false
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_TOKEN=
SELF_HOSTED_LLM_MODEL=
