FROM postgres:18-bookworm
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/backup-venv
COPY Backend/backup-requirements.txt /opt/backup-requirements.txt
RUN /opt/backup-venv/bin/pip install --no-cache-dir -r /opt/backup-requirements.txt
ENV PATH="/opt/backup-venv/bin:${PATH}" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/click-backup
COPY Backend/scripts/database_backup.py Backend/scripts/managed_database_backup.py ./
USER postgres
ENTRYPOINT []
CMD ["python", "managed_database_backup.py", "backup"]
