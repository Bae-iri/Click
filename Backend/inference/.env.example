# Use with: uvicorn inference.whisper_stt:app --env-file inference/.env --workers 1 --no-access-log
# Pre-provision the pinned Systran/faster-whisper-large-v3 snapshot in this directory.
WHISPER_MODEL_PATH=/srv/models/faster-whisper-large-v3
# cuda defaults to float16; for CPU use WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Must match Backend's SELF_HOSTED_STT_TOKEN and contain at least 32 random characters.
SELF_HOSTED_STT_TOKEN=
