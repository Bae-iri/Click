{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {"format": "%(levelname)s %(name)s %(message)s"}
  },
  "handlers": {
    "console": {"class": "logging.StreamHandler", "formatter": "default", "stream": "ext://sys.stderr"}
  },
  "loggers": {
    "click.http": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "click.validation": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "app.services.gov24_experiment": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "CRITICAL", "propagate": false}
  }
}
