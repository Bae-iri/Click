# Development only. Uvicorn reads this file only with --env-file .env.
DATABASE_URL=sqlite+pysqlite:///./click-dev.db
# Leave empty to use the existing local scorer without external AI calls.
GEMINI_API_KEY=
AGENT_SESSION_IDLE_SECONDS=1800
AGENT_TURN_LEASE_SECONDS=60
# Must be positive and shorter than AGENT_TURN_LEASE_SECONDS.
AGENT_TURN_TIMEOUT_SECONDS=20
# Optional mail delivery. No tokens are returned to clients or written to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Separate operator credential, at least 32 random characters; blank disables metrics.
OPS_TOKEN=
# Development retention used by scripts/maintenance.py; schedule externally.
DATA_RETENTION_SECONDS=86400
