# Development only. Uvicorn reads this file only with --env-file .env.
DATABASE_URL=sqlite+pysqlite:///./click-dev.db
# Leave empty to use the existing local scorer without external AI calls.
GEMINI_API_KEY=
AGENT_SESSION_IDLE_SECONDS=1800
AGENT_TURN_LEASE_SECONDS=60
# Must be positive and shorter than AGENT_TURN_LEASE_SECONDS.
AGENT_TURN_TIMEOUT_SECONDS=20
# Optional mail delivery. No tokens are returned to clients or written to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Separate operator credential, at least 32 random characters; blank disables metrics.
OPS_TOKEN=
# Numeric Kakao Developers app ID (not an app key). Blank disables Kakao login.
KAKAO_APP_ID=
# Goal interpretation provider. Default keeps classification on our own inference server.
# jev explicitly sends minimized request TEXT to TypeSafe's external API.
# Before live Jev use, request and verify enterprise ZDR and decide whether external
# processing is permitted. ZDR still transmits text; see inference/jev.md.
GOAL_CLASSIFIER_PROVIDER=self_hosted
CLICK_COUPANG_BROWSE_ENABLED=1
# Agent(2): save new graph drafts after browsing, retry retained work every minute.
CLICK_AI2_BROWSE_GRAPH_ENABLED=1
CLICK_AI2_BROWSE_GRAPH_INTERVAL_SECONDS=60
# AI1 primary decision-maker: Jev selects the current graph step AND observed UI.
# rules (or legacy local) explicitly selects the previous local implementation.
AI1_UI_SELECTOR_PROVIDER=jev
# Shared Jev key for AI1 and optional goal classification. Backend only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# Provisional experiment setting, NOT a measured correctness guarantee.
JEV_MIN_CONFIDENCE=0.8
# Three independent screen judgments in ONE request. Explicit legacy mode is a rollback only.
JEV_SCREEN_JUDGMENT_MODE=atomic
# Local softmax(log(p)/T) diagnostics; raw scores still control acceptance.
JEV_CHOICE_TEMPERATURE=0.7
# OpenAI-compatible chat protocol served by our own LLM, not a public AI API.
# Full /v1/chat/completions endpoint. Remote hosts require HTTPS; loopback may use HTTP.
# All three values are required. Blank/failed inference keeps the clarification flow.
# Bearer token stays on Backend. No classifier fallback to an external provider.
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_TOKEN=
SELF_HOSTED_LLM_MODEL=
# Development retention used by scripts/maintenance.py; schedule externally.
DATA_RETENTION_SECONDS=86400

# Optional speech copy generation, separate from classification. Uses private SELF_HOSTED_LLM above.
# false or missing configuration keeps original messages. Hard response budget: 800ms.
GUIDE_NARRATION_ENABLED=false

# Government24 public login selection pilot; actual authentication is manual.
CLICK_GOV24_GUIDE_ENABLED=1
